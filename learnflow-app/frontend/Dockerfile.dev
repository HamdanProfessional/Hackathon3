# Development Dockerfile for LearnFlow Frontend
# This is optimized for local development with hot-reload

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Copy all files
COPY . .

# Expose development port
EXPOSE 3000

# Set environment
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Start development server with hot-reload
CMD ["npm", "run", "dev"]
