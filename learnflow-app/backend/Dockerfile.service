# Multi-service Dockerfile for LearnFlow Backend Services
# Build targets for each service

FROM python:3.11-slim AS base
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e .

# Copy shared code
COPY shared/ ./shared/

# Triage Service
FROM base AS triage
COPY services/triage/ ./services/triage/
ENV PORT=8001
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "services.triage.main:app", "--host", "0.0.0.0", "--port", "8001"]

# Concepts Service
FROM base AS concepts
COPY services/concepts/ ./services/concepts/
ENV PORT=8002
EXPOSE 8002
CMD ["python", "-m", "uvicorn", "services.concepts.main:app", "--host", "0.0.0.0", "--port", "8002"]

