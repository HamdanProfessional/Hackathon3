# Multi-stage Dockerfile for LearnFlow Backend Services
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for faster dependency management
RUN pip install uv

# Copy dependency files
COPY pyproject.toml ./

# Install dependencies using uv
RUN uv pip install --system -e .

# Copy application code
COPY . .

# Service targets
FROM base AS triage
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "services.triage.main:app", "--host", "0.0.0.0", "--port", "8001"]

FROM base AS concepts
EXPOSE 8002
CMD ["python", "-m", "uvicorn", "services.concepts.main:app", "--host", "0.0.0.0", "--port", "8002"]

FROM base AS debug
EXPOSE 8003
CMD ["python", "-m", "uvicorn", "services.debug.main:app", "--host", "0.0.0.0", "--port", "8003"]

FROM base AS exercise
EXPOSE 8004
CMD ["python", "-m", "uvicorn", "services.exercise.main:app", "--host", "0.0.0.0", "--port", "8004"]

FROM base AS progress
EXPOSE 8005
CMD ["python", "-m", "uvicorn", "services.progress.main:app", "--host", "0.0.0.0", "--port", "8005"]

FROM base AS code_review
EXPOSE 8006
CMD ["python", "-m", "uvicorn", "services.code_review.main:app", "--host", "0.0.0.0", "--port", "8006"]

# Default target
FROM base
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "services.triage.main:app", "--host", "0.0.0.0", "--port", "8001"]
