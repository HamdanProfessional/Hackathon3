{
  "name": "learnflow-code-exec",
  "version": "1.0.0",
  "description": "MCP server providing safe Python code execution for LearnFlow exercises",
  "author": "LearnFlow Team",
  "license": "MIT",
  "tools": [
    {
      "name": "execute_code",
      "description": "Execute Python code in a sandboxed environment with timeout and resource limits",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Python code to execute"
          },
          "timeout": {
            "type": "integer",
            "default": 5,
            "maximum": 10,
            "description": "Execution timeout in seconds (max 10s)"
          },
          "max_memory": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "description": "Maximum memory in MB (max 100MB)"
          }
        },
        "required": ["code"]
      }
    },
    {
      "name": "test_code",
      "description": "Test Python code against predefined test cases and return results",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Python code to test"
          },
          "test_cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "string",
                  "description": "Input for the test case"
                },
                "expected_output": {
                  "type": "string",
                  "description": "Expected output"
                }
              }
            }
          }
        },
        "required": ["code"]
      }
    },
    {
      "name": "analyze_code",
      "description": "Analyze Python code for syntax errors, style issues, and potential bugs",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Python code to analyze"
          }
        },
        "required": ["code"]
      }
    },
    {
      "name": "format_code",
      "description": "Format Python code according to PEP 8 style guidelines",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Python code to format"
          }
        },
        "required": ["code"]
      }
    },
    {
      "name": "get_execution_history",
      "description": "Retrieve recent code execution history for a student session",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session identifier"
          },
          "limit": {
            "type": "integer",
            "default": 10,
            "description": "Maximum history entries"
          }
        },
        "required": ["session_id"]
      }
    }
  ]
}
